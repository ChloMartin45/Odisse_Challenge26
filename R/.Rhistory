library(tidyverse)
library(FactoMineR)
library(factoextra)
library(sf)
library(giscoR) # permet de récupérer les géométries administratives européennes directement depuis les données GISCO d'Eurostat.
territoires <- read_csv(
"~/projects/Odisse_Challenge26/data/processed/territoires_regions.csv",
show_col_types = FALSE
)
sante <- read_csv(
"~/projects/Odisse_Challenge26/data/processed/sante_regions.csv",
show_col_types = FALSE
)
diabete <- read_csv(
"~/projects/Odisse_Challenge26/data/processed/diabete_regions.csv",
show_col_types = FALSE
)
sante <- sante |>
mutate(
region = `Nouvelles régions`
)
diabete <- diabete |>
mutate(
region = `Nouvelles régions`
)
sante <- sante |>
mutate(
region = recode(
region,
"Ile-de-France" = "Île-de-France",
"Bourgogne-Franche-Comté" = "Bourgogne et Franche-Comté",
"Nouvelle-Aquitaine" = "Nouvelle Aquitaine",
"Auvergne-Rhône-Alpes" = "Auvergne et Rhône-Alpes"
)
)
diabete <- diabete |>
mutate(
region = recode(
region,
"Ile-de-France" = "Île-de-France",
"Bourgogne-Franche-Comté" = "Bourgogne et Franche-Comté",
"Nouvelle-Aquitaine" = "Nouvelle Aquitaine",
"Auvergne-Rhône-Alpes" = "Auvergne et Rhône-Alpes"
)
)
sante_analyse <- sante |>
select(
region,
Indicateur,
Estimation
) |>
pivot_wider(
names_from = Indicateur,
values_from = Estimation
) |>
rename(
sante_percue = `Santé perçue bonne ou très bonne`,
limitation_activite = `Limitation d'activité`
)
diabete_analyse <- diabete |>
select(
region,
Estimation
) |>
rename(
diabete_declare = Estimation
)
analyse_regions <- territoires |>
inner_join(
sante_analyse,
by = "region"
) |>
inner_join(
diabete_analyse,
by = "region"
)
analyse_regions |>
summarise(
nb_regions = n(),
nb_valeurs_manquantes = sum(
is.na(
sante_percue
) |
is.na(
limitation_activite
) |
is.na(
diabete_declare
) |
is.na(
fdep_pondere
) |
is.na(
fedi_pondere
) |
is.na(
apl_pondere
)
)
)
analyse_regions |>
select(
region,
population,
fdep_pondere,
fedi_pondere,
apl_pondere,
sante_percue,
limitation_activite,
diabete_declare
) |>
arrange(region)
write_csv(
analyse_regions,
"~/projects/Odisse_Challenge26/data/processed/analyse_regions.csv"
)
analyse_regions <- analyse_regions |>
select(
code_region,
region,
population,
fdep_pondere,
fedi_pondere,
apl_pondere,
sante_percue,
limitation_activite,
diabete_declare
)
# valeur élevée = davantage défavorable
analyse_regions <- analyse_regions |>
mutate(
z_fdep = as.numeric(scale(fdep_pondere)),
z_fedi = as.numeric(scale(fedi_pondere)),
z_apl = as.numeric(scale(-apl_pondere)),
z_sante = as.numeric(scale(-sante_percue)),
z_limitation = as.numeric(scale(limitation_activite)),
z_diabete = as.numeric(scale(diabete_declare))
)
# = associations exploratoires (que 13 régions)
correlations <- analyse_regions |>
select(
fdep_pondere,
fedi_pondere,
apl_pondere,
sante_percue,
limitation_activite,
diabete_declare
) |>
cor()
# Indicateur défavorable social
analyse_regions <- analyse_regions |>
mutate(
score_defavorisation = rowMeans(
cbind(z_fdep, z_fedi),
na.rm = TRUE
)
)
# score_defavorisation = niveau relatif de défavorisation
# Indicateur Santé défavorable
analyse_regions <- analyse_regions |>
mutate(
score_sante = rowMeans(
cbind(
z_sante,
z_limitation,
z_diabete
),
na.rm = TRUE
)
)
# score_sante = profil de santé relativement défavorable
analyse_regions |>
select(
region,
score_defavorisation,
z_apl,
score_sante
) |>
arrange(score_defavorisation)
analyse_regions |>
select(
region,
score_defavorisation,
z_apl,
score_sante
) |>
arrange(score_sante)
sante_longue <- analyse_regions |>
select(
region,
sante_percue,
limitation_activite,
diabete_declare
) |>
pivot_longer(
cols = -region,
names_to = "indicateur",
values_to = "valeur"
)
territoires_long <- analyse_regions |>
select(
region,
fdep_pondere,
fedi_pondere,
apl_pondere
) |>
pivot_longer(
cols = -region,
names_to = "indicateur",
values_to = "valeur"
)
profils_regions <- analyse_regions |>
select(
region,
z_fdep,
z_fedi,
z_apl,
z_sante,
z_limitation,
z_diabete
) |>
pivot_longer(
cols = -region,
names_to = "dimension",
values_to = "score"
)
ggplot(
analyse_regions,
aes(
x = score_defavorisation,
y = score_sante,
size = population
)
) +
geom_point() +
geom_text(
aes(label = region),
vjust = -0.8,
size = 3
) +
labs(
x = "Défavorisation territoriale",
y = "Profil de santé défavorable",
size = "Population",
title = "Défavorisation territoriale et profil de santé"
) +
theme_minimal()
ggplot(
analyse_regions,
aes(
x = fdep_pondere,
y = score_sante,
size = population,
color = apl_pondere
)
) +
geom_point(alpha = 0.8) +
geom_text(
aes(label = region),
vjust = -0.8,
size = 3
) +
labs(
x = "Défavorisation territoriale (FDep)",
y = "Profil de santé défavorable",
size = "Population",
color = "APL",
title = "Défavorisation territoriale et profil de santé"
) +
theme_minimal()
profils_regions <- analyse_regions |>
select(
region,
z_fdep,
z_fedi,
z_apl,
z_sante,
z_limitation,
z_diabete
) |>
pivot_longer(
cols = starts_with("z_"),
names_to = "indicateur",
values_to = "score"
) |>
